# ══════════════════════════════════════════════════════════════════════════════
# AI Email Agent — Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=Email Wake-Up Agent
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Use the Transaction mode pooler URL (port 6543) — NOT session mode (5432).
# Transaction mode supports more concurrent connections and works with NullPool.
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string
# Encode @ in password as %40 for asyncpg compatibility.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.pooler.supabase.com:6543/postgres

# ── Redis / Celery ────────────────────────────────────────────────────────────
# For local dev with Docker: redis://localhost:6379/0
# For Docker Compose (all services in containers): redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
# Get a free API key at https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Enable Gmail API
# 3. Create OAuth 2.0 credentials (Desktop App type)
# 4. Download JSON → save as backend/credentials/gmail_credentials.json
# 5. Run the app once — it will open a browser to authorize and create gmail_token.json
GMAIL_CREDENTIALS_JSON=credentials/gmail_credentials.json
GMAIL_TOKEN_JSON=credentials/gmail_token.json
GMAIL_POLL_INTERVAL_SECONDS=60

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# Same GCP project — enable Calendar API
# Download credentials → save as backend/credentials/calendar_credentials.json
CALENDAR_CREDENTIALS_JSON=credentials/calendar_credentials.json
CALENDAR_TOKEN_JSON=credentials/calendar_token.json

# ── Agent Defaults ────────────────────────────────────────────────────────────
AGENT_DEFAULT_TONE=professional
AGENT_DEFAULT_TIMEZONE=UTC
AGENT_DEFAULT_WORKING_HOURS_START=9
AGENT_DEFAULT_WORKING_HOURS_END=18
AGENT_DEFAULT_BUDGET_CEILING=5000.0
AGENT_MAX_RESCHEDULE_ATTEMPTS=3
