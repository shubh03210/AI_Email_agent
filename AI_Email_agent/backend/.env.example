# ══════════════════════════════════════════════════════════════════════════════
# AI Email Agent — Environment Variables Template
#
# 1. Copy this file:   cp backend/.env.example backend/.env
# 2. Fill in every value marked  ← REQUIRED
# 3. Review values marked        ← RECOMMENDED to change before production
# 4. Never commit the real .env file (it's in .gitignore)
#
# Startup checks will log warnings for missing or placeholder values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=Email Wake-Up Agent
VERSION=1.0.0
DEBUG=false                      # Set true for hot-reload in local dev
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Security / JWT ────────────────────────────────────────────────────────────
# SECRET_KEY must be ≥ 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars   # ← REQUIRED

# JWT algorithm — HS256 is fine for most deployments
ALGORITHM=HS256

# Token lifetime in minutes (positive integer)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Bootstrap admin account ───────────────────────────────────────────────────
# Used ONCE on first startup when the users table is empty.
# After bootstrap, manage users via the API.
# ADMIN_PASSWORD must be ≥ 8 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production-use-a-strong-password          # ← REQUIRED

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Use the Transaction mode pooler URL (port 6543) — NOT session mode (5432).
# NullPool (used by async SQLAlchemy) requires transaction mode.
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string
#
# Encode special chars in password: @ → %40
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.pooler.supabase.com:6543/postgres  # ← REQUIRED

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Local dev (backend outside Docker, Redis in Docker):
#   REDIS_URL=redis://localhost:6379/0
# Docker Compose (all services in containers):
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
# Free API key: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here                                   # ← REQUIRED
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Setup steps:
#   1. Go to https://console.cloud.google.com/ and create/select a project
#   2. Enable Gmail API
#   3. Create OAuth 2.0 credentials → Desktop App type
#   4. Download JSON → save as backend/credentials/gmail_credentials.json
#   5. On first run, a browser window will open to authorize → creates gmail_token.json
GMAIL_CREDENTIALS_JSON=credentials/gmail_credentials.json
GMAIL_TOKEN_JSON=credentials/gmail_token.json
GMAIL_POLL_INTERVAL_SECONDS=60

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# Same GCP project as Gmail above.
#   1. Enable Calendar API
#   2. Download OAuth JSON → save as backend/credentials/calendar_credentials.json
CALENDAR_CREDENTIALS_JSON=credentials/calendar_credentials.json
CALENDAR_TOKEN_JSON=credentials/calendar_token.json

# ── Agent Defaults ────────────────────────────────────────────────────────────
# These are fallback values used when no AgentConfig row exists in the DB.
# Runtime values are managed via the /api/v1/config/ endpoint (Config page in the UI).
AGENT_DEFAULT_TONE=formal                    # formal | friendly | startup | executive
AGENT_DEFAULT_TIMEZONE=UTC                   # IANA timezone, e.g. America/New_York
AGENT_DEFAULT_WORKING_HOURS_START=9          # 0–23
AGENT_DEFAULT_WORKING_HOURS_END=18           # 0–23
AGENT_DEFAULT_BUDGET_CEILING=5000.0          # Max compensation the agent will accept
AGENT_MAX_RESCHEDULE_ATTEMPTS=3              # Before escalating to human review

# ── LangGraph Hardening ───────────────────────────────────────────────────────
# Minimum confidence score (0.0–1.0) for classify_intent to act on a signal.
# Below this threshold, the intent is downgraded to "ambiguous".
INTENT_CONFIDENCE_THRESHOLD=0.45

# Consecutive ambiguous classifications before a thread is escalated.
AMBIGUOUS_ESCALATION_THRESHOLD=3

# Recent messages to keep in full in the LLM context window.
MEMORY_WINDOW_MESSAGES=20

# Minimum total message count before a rolling summary is generated.
MEMORY_SUMMARY_TRIGGER=25

# ── Calendar Reliability ──────────────────────────────────────────────────────
# Consecutive calendar operation failures before a meeting is flagged for human review.
CALENDAR_MAX_FAILURES=3

# ── Task Infrastructure ───────────────────────────────────────────────────────
TASK_MAX_RETRIES_GMAIL=5        # Gmail / outreach tasks
TASK_MAX_RETRIES_AGENT=3        # LangGraph agent run tasks
TASK_MAX_RETRIES_DEFAULT=3      # Cleanup and misc tasks
TASK_RETRY_BACKOFF_BASE=30      # Seconds — initial exponential backoff
TASK_RETRY_BACKOFF_CAP=600      # Seconds — maximum backoff ceiling

TASK_DLQ_MAX_SIZE=1000          # Max entries in the Redis dead-letter queue

# Outreach idempotency lock TTL — prevents duplicate emails on retry (24 h)
TASK_OUTREACH_IDEM_TTL=86400

# Agent enqueue deduplication TTL — prevents re-queuing a running agent run (6 min)
TASK_AGENT_ENQUEUE_TTL=360
