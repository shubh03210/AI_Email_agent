# ── Application ────────────────────────────────────────────────────────────────
PROJECT_NAME=Email Wake-Up Agent
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Security ────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret-key-in-production

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/email_agent

# ── Redis / Celery ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── LLM (Groq) ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── Gmail OAuth ───────────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create OAuth 2.0 credentials (Desktop App)
# 3. Download JSON → save as credentials/gmail_credentials.json
GMAIL_CREDENTIALS_JSON=credentials/gmail_credentials.json
GMAIL_TOKEN_JSON=credentials/gmail_token.json
GMAIL_POLL_INTERVAL_SECONDS=60

# ── Google Calendar OAuth ─────────────────────────────────────────────────────────
# Same GCP project — enable Calendar API and save to credentials/calendar_credentials.json
CALENDAR_CREDENTIALS_JSON=credentials/calendar_credentials.json
CALENDAR_TOKEN_JSON=credentials/calendar_token.json

# ── Agent Defaults ────────────────────────────────────────────────────────────────
AGENT_DEFAULT_TONE=professional
AGENT_DEFAULT_TIMEZONE=UTC
AGENT_DEFAULT_WORKING_HOURS_START=9
AGENT_DEFAULT_WORKING_HOURS_END=18
AGENT_DEFAULT_BUDGET_CEILING=5000.0
AGENT_MAX_RESCHEDULE_ATTEMPTS=3
